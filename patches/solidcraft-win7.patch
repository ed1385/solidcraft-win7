+//! Windows 7 build helpers: a log file for diagnosis (the GUI app has no console) and the
+//! software OpenGL renderer (Mesa llvmpipe in `soft-gl\` next to the exe), loaded before any
+//! OpenGL use when the software renderer is chosen.
+#![allow(unsafe_code)]
+
+use std::io::Write;
+use std::os::windows::io::IntoRawHandle;
+use std::sync::Mutex;
+
+/// `%LOCALAPPDATA%\SolidCraft\solidcraft-log.txt`.
+pub fn log_path() -> Option<std::path::PathBuf> {
+    std::env::var_os("LOCALAPPDATA").map(|d| std::path::PathBuf::from(d).join("SolidCraft").join("solidcraft-log.txt"))
+}
+
+/// Everything written to stderr (eprintln!, the log) goes to the log file from now on.
+pub fn redirect_stderr() {
+    let Some(path) = log_path() else { return };
+    if let Some(dir) = path.parent() {
+        let _ = std::fs::create_dir_all(dir);
+    }
+    let Ok(file) = std::fs::File::create(&path) else { return };
+    let handle = file.into_raw_handle();
+    // SAFETY: a valid, owned file handle, intentionally kept open for the life of the process.
+    // SetStdHandle looked up in kernel32 (keeps windows-sys' feature set unchanged).
+    unsafe {
+        use windows_sys::Win32::System::LibraryLoader::{GetModuleHandleW, GetProcAddress};
+        let k32: Vec<u16> = "kernel32.dll\0".encode_utf16().collect();
+        let m = GetModuleHandleW(k32.as_ptr());
+        if let Some(f) = GetProcAddress(m, b"SetStdHandle\0".as_ptr()) {
+            let f: unsafe extern "system" fn(u32, *mut core::ffi::c_void) -> i32 = std::mem::transmute(f);
+            f(0xFFFF_FFF4, handle as _);
+        }
+    }
+}
+
+struct StderrLog(Mutex<()>);
+
+impl log::Log for StderrLog {
+    fn enabled(&self, m: &log::Metadata) -> bool {
+        let ours = m.target().starts_with("solidcraft");
+        m.level() <= if ours { log::Level::Info } else { log::Level::Warn }
+            || (m.target().starts_with("wgpu") && m.level() <= log::Level::Info)
+            || m.target().starts_with("egui_wgpu") && m.level() <= log::Level::Info
+    }
+    fn log(&self, r: &log::Record) {
+        if self.enabled(r.metadata()) {
+            let _g = self.0.lock();
+            let t = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_millis());
+            let _ = writeln!(std::io::stderr(), "{t} {} {}: {}", r.level(), r.target(), r.args());
+        }
+    }
+    fn flush(&self) {}
+}
+
+static LOGGER: StderrLog = StderrLog(Mutex::new(()));
+
+pub fn install_logger() {
+    if log::set_logger(&LOGGER).is_ok() {
+        log::set_max_level(log::LevelFilter::Info);
+    }
+}
+
+/// Load Mesa's opengl32.dll from `soft-gl\` beside the exe, before anything loads the system
+/// one: every later lookup of `opengl32.dll` (gdi32, wgpu) then gets llvmpipe.
+pub fn preload_software_gl() -> bool {
+    let Some(dir) = std::env::current_exe().ok().and_then(|e| e.parent().map(|p| p.join("soft-gl"))) else { return false };
+    let dll = dir.join("opengl32.dll");
+    if !dll.is_file() {
+        eprintln!("SolidCraft: software OpenGL not found at {}", dll.display());
+        return false;
+    }
+    use std::os::windows::ffi::OsStrExt;
+    let wide: Vec<u16> = dll.as_os_str().encode_wide().chain(std::iter::once(0)).collect();
+    // SAFETY: a NUL-terminated path; LOAD_WITH_ALTERED_SEARCH_PATH finds Mesa's own DLLs beside it.
+    let h = unsafe {
+        windows_sys::Win32::System::LibraryLoader::LoadLibraryExW(
+            wide.as_ptr(),
+            std::ptr::null_mut(),
+            windows_sys::Win32::System::LibraryLoader::LOAD_WITH_ALTERED_SEARCH_PATH,
+        )
+    };
+    let ok = !h.is_null();
+    eprintln!("SolidCraft: software OpenGL (Mesa llvmpipe) {}", if ok { "loaded" } else { "failed to load" });
+    ok
+}
