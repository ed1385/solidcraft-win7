+#[cfg(target_os = "windows")]
+fn old_hardware_gl() -> Option<String> {
+    use eframe::wgpu::Backends;
+    if startup::has_hardware_adapter(Backends::DX12) || startup::has_hardware_adapter(Backends::VULKAN) {
+        return None;
+    }
+    let mut desc = eframe::wgpu::InstanceDescriptor::new_without_display_handle();
+    desc.backends = Backends::GL;
