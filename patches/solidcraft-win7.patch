+fn user32_proc(name: &[u8]) -> Option<unsafe extern "system" fn() -> isize> {
+    let module: Vec<u16> = "user32.dll\0".encode_utf16().collect();
+    // SAFETY: NUL-terminated strings; user32 is always loaded in a GUI process.
+    unsafe {
+        let h = GetModuleHandleW(module.as_ptr());
